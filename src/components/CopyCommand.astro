---
import { Check, Copy } from '@lucide/astro';

interface Props {
	command: string;
}

const { command } = Astro.props;
---

<div class="command" data-copy-command>
	<code>{command}</code>
	<button
		type="button"
		class="copy-button"
		data-copy-text={command}
		aria-label="Copy install command"
		title="Copy install command"
	>
		<span class="icon copy-icon" aria-hidden="true">
			<Copy size={16} stroke-width={2} />
		</span>
		<span class="icon check-icon" aria-hidden="true">
			<Check size={16} stroke-width={2} />
		</span>
	</button>
	<span class="sr-only" data-copy-status aria-live="polite"></span>
</div>

<script>
	const commands = document.querySelectorAll<HTMLElement>('[data-copy-command]');

	commands.forEach((command) => {
		const button = command.querySelector<HTMLButtonElement>('[data-copy-text]');
		const status = command.querySelector<HTMLElement>('[data-copy-status]');
		let resetTimer: number | undefined;

		button?.addEventListener('click', async () => {
			const text = button.dataset.copyText;
			if (!text) return;

			try {
				await navigator.clipboard.writeText(text);
				button.dataset.copied = 'true';
				button.setAttribute('aria-label', 'Copied');
				button.setAttribute('title', 'Copied');
				if (status) status.textContent = 'Install command copied';

				window.clearTimeout(resetTimer);
				resetTimer = window.setTimeout(() => {
					delete button.dataset.copied;
					button.setAttribute('aria-label', 'Copy install command');
					button.setAttribute('title', 'Copy install command');
					if (status) status.textContent = '';
				}, 2000);
			} catch {
				if (status) status.textContent = 'Could not copy the install command';
			}
		});
	});
</script>

<style>
	.command {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 2.75rem;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0.375rem 0.5rem 0.375rem 1.125rem;
		border-top: 1px solid var(--rule);
	}

	.command code {
		min-width: 0;
		padding: 0;
		background: transparent;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	.copy-button {
		position: relative;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--ink-faint);
		cursor: pointer;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
	}

	.copy-button:hover,
	.copy-button:focus-visible,
	.copy-button[data-copied='true'] {
		background: #f3f3f3;
		color: var(--ink);
	}

	.copy-button:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	.icon {
		position: absolute;
		display: grid;
		place-items: center;
	}

	.check-icon {
		opacity: 0;
		transform: scale(0.25);
		filter: blur(4px);
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.copy-button {
			transition:
				transform 150ms var(--ease-out),
				background-color 150ms ease,
				color 150ms ease;
		}

		.copy-button:active {
			transform: scale(0.96);
		}

		.copy-icon :global(rect),
		.copy-icon :global(path) {
			transition: transform 150ms var(--ease-out);
		}

		.copy-button:hover:not([data-copied='true']) .copy-icon :global(rect) {
			transform: translate(-1.5px, -1.5px);
		}

		.copy-button:hover:not([data-copied='true']) .copy-icon :global(path) {
			transform: translate(1.5px, 1.5px);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.icon {
			transition:
				opacity 150ms cubic-bezier(0.2, 0, 0, 1),
				transform 150ms cubic-bezier(0.2, 0, 0, 1),
				filter 150ms cubic-bezier(0.2, 0, 0, 1);
		}
	}

	.copy-button[data-copied='true'] .copy-icon {
		opacity: 0;
		transform: scale(0.25);
		filter: blur(4px);
	}

	.copy-button[data-copied='true'] .check-icon {
		opacity: 1;
		transform: scale(1);
		filter: blur(0);
	}
</style>
