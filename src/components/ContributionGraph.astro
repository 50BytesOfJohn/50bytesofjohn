---
/**
 * GitHub contribution grid, fetched at build time and rendered in grayscale.
 *
 * ponytail: uses the public jogruber proxy so no GitHub token is needed. The data is
 * frozen at build time — rebuild (or move to the GitHub GraphQL API) if it needs to be
 * live. Renders nothing if the fetch fails, the page must not depend on it.
 */
interface Props {
	user: string;
}

interface Day {
	date: string;
	count: number;
	level: 0 | 1 | 2 | 3 | 4;
}

const { user } = Astro.props;

let days: Day[] = [];
let total = 0;

try {
	// Timeout matters once this renders per-request: a hung proxy must not hold the
	// response open, it just costs us the section.
	const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${user}?y=last`, {
		signal: AbortSignal.timeout(5000),
	});
	if (res.ok) {
		const data = (await res.json()) as { total: Record<string, number>; contributions: Day[] };
		days = data.contributions;
		total = Object.values(data.total)[0] ?? 0;
	}
} catch {
	// Offline build or the proxy is down — the section just disappears.
}

// Pad so the first column starts on a Sunday.
const offset = days.length ? new Date(days[0].date).getUTCDay() : 0;
---

{
	days.length > 0 && (
		<figure class="graph">
			<div class="grid" aria-hidden="true">
				{Array.from({ length: offset }, (_, i) => (
					<span class="cell" data-level="empty" />
				))}
				{days.map((day) => (
					<span class="cell" data-level={day.level} />
				))}
			</div>
			<figcaption class="sr-only">{total} GitHub contributions in the last year.</figcaption>
		</figure>
	)
}

<style>
	.graph {
		margin: 0;
	}

	.grid {
		display: grid;
		grid-template-rows: repeat(7, 1fr);
		grid-auto-flow: column;
		grid-auto-columns: 1fr;
		gap: 2px;
	}

	.cell {
		aspect-ratio: 1;
		border-radius: 1px;
		background: var(--level-0);
	}

	.cell[data-level='empty'] {
		background: none;
	}
	.cell[data-level='1'] {
		background: var(--level-1);
	}
	.cell[data-level='2'] {
		background: var(--level-2);
	}
	.cell[data-level='3'] {
		background: var(--level-3);
	}
	.cell[data-level='4'] {
		background: var(--level-4);
	}

	.grid {
		--level-0: #f2f2f2;
		--level-1: #d6d6d6;
		--level-2: #ababab;
		--level-3: #6b6b6b;
		--level-4: #171717;
	}
</style>
