---
/**
 * Posts grouped by month: the "Aug 2026" label sits in the leading column and the titles hang
 * off it, so the section matches the projects list above — label left, one entry per row.
 */
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

// pubDate is parsed as local midnight, so it has to be formatted locally too — the same
// assumption FormattedDate makes.
const monthAndYear = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });

// Posts arrive newest-first and a Map keeps insertion order, so the months come out descending.
const months = new Map<string, CollectionEntry<'blog'>[]>();
for (const post of posts) {
	const label = monthAndYear.format(post.data.pubDate);
	const entries = months.get(label);
	if (entries) entries.push(post);
	else months.set(label, [post]);
}
---

<div class="log">
	{
		[...months].map(([label, entries]) => (
			// The month names the list rather than being a heading, so the component can sit under
			// an h1 or an h2 without skipping a level.
			<div class="month">
				<p class="month-label" id={`posts-${label.replace(' ', '-')}`}>
					{label}
				</p>
				<ul class="posts" aria-labelledby={`posts-${label.replace(' ', '-')}`}>
					{entries.map((post) => (
						<li>
							<a
								href={post.data.externalUrl ?? `/blog/${post.id}/`}
								{...(post.data.externalUrl ? { target: '_blank', rel: 'noopener' } : {})}
							>
								<span class="title-text">{post.data.title}</span>
								{post.data.externalUrl ? (
									<ArrowUpRight class="arrow" size={14} stroke-width={2} aria-hidden="true" />
								) : (
									<ArrowRight class="arrow" size={14} stroke-width={2} aria-hidden="true" />
								)}
							</a>
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>

<style>
	.log {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* Same two columns as the projects list, so both sections share one leading edge. */
	.month {
		display: grid;
		grid-template-columns: 7rem 1fr;
		align-items: baseline;
		gap: 0 1.5rem;
	}

	.month-label {
		margin: 0;
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		color: var(--ink-faint);
	}

	.posts {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		/* Only the title carries the underline; the arrow is metadata. */
		text-decoration: none;
		border-radius: 2px;
	}

	a:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 6px;
	}

	.title-text {
		font-weight: 500;
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: text-decoration-color 150ms ease;
	}

	a:hover .title-text,
	a:focus-visible .title-text {
		text-decoration-color: var(--ink);
	}

	a :global(.arrow) {
		margin-inline-start: 0.4em;
		vertical-align: -0.1em;
		color: var(--ink-faint);
		opacity: 0;
		transform: translateX(-3px);
		transition:
			opacity 150ms var(--ease-out),
			transform 150ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		a:hover :global(.arrow) {
			opacity: 1;
			transform: none;
		}
	}

	a:focus-visible :global(.arrow) {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		a :global(.arrow) {
			transform: none;
			transition: opacity 150ms ease;
		}
	}

	@media (max-width: 30rem) {
		.month {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
