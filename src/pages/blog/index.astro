---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import SiteMasthead from '../../components/SiteMasthead.astro';
import { SITE_TITLE } from '../../consts';
import PersonalPage from '../../layouts/PersonalPage.astro';

const description = 'Notes on the things I build — queues, local-first apps and agent skills.';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PersonalPage title={`Writing | ${SITE_TITLE}`} description={description}>
	<SiteMasthead action="back" />

	<section class="intro" aria-labelledby="writing-title">
		<h1 id="writing-title">Writing</h1>
		<p>{description}</p>
	</section>

	<PostList posts={posts} />
</PersonalPage>

<style>
	.intro {
		max-width: 31rem;
	}

	h1 {
		margin: 0 0 0.75rem;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--ink);
	}

	.intro p {
		margin: 0;
		text-wrap: pretty;
	}
</style>
