---
import CopyCommand from '../components/CopyCommand.astro';
import SiteMasthead from '../components/SiteMasthead.astro';
import { SITE_TITLE } from '../consts';
import PersonalPage from '../layouts/PersonalPage.astro';

const description =
	'Skills that grew out of my daily work with AI agents. Each one exists because I needed it.';
---

<PersonalPage title={`Agent skills | ${SITE_TITLE}`} description={description}>
	<SiteMasthead action="back" />

	<section class="intro" aria-labelledby="skills-title">
		<h1 id="skills-title">Agent skills</h1>
		<p>{description}</p>
	</section>

	<section aria-labelledby="install-title">
		<h2 id="install-title" class="label">Install all</h2>
		<CopyCommand command="npx skills add 50BytesOfJohn/skills" />
	</section>
</PersonalPage>

<style>
	.intro {
		max-width: 31rem;
	}

	h1 {
		margin: 0 0 0.75rem;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--ink);
	}

	.intro p {
		margin: 0;
		text-wrap: pretty;
	}

	.label {
		margin: 0 0 1rem;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
</style>
