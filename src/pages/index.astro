---
import BaseHead from '../components/BaseHead.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import Shuffle from '../components/Shuffle.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const socials = [
	{ label: 'X', href: 'https://x.com/50BytesOfJohn' },
	{ label: 'GitHub', href: 'https://github.com/50BytesOfJohn' },
	{ label: 'Blog', href: 'https://hashnode.com/@50BytesOfJohn' },
];

const projects = [
	{
		name: 'Mynth',
		href: 'https://mynth.io',
		description: 'Your Infra for AI media.',
		source: 'https://github.com/mynthio/oss',
	},
	{
		name: 'Hanoki',
		href: 'https://hanoki.app',
		description: 'Local-first, open-source AI chat desktop app for macOS.',
		source: 'https://github.com/50BytesOfJohn/hanoki',
	},
	{
		name: 'Panqueue',
		href: 'https://panqueue.dev',
		description: 'Runtime-agnostic TypeScript queue library for Node, Bun and Deno.',
		source: 'https://github.com/50BytesOfJohn/panqueue',
	},
	{
		name: 'Prsna',
		href: 'https://prsna.app',
		description: 'AI roleplay chat and character generator.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main class="page">
			<header class="intro">
				<Shuffle text="50BytesOfJohn" tag="h1" class="wordmark" loop loopDelay={5} />
				<nav class="socials" aria-label="Elsewhere">
					{
						socials.map((social) => (
							<a href={social.href} rel="me noopener" target="_blank">
								{social.label}
							</a>
						))
					}
				</nav>
			</header>

			<section>
				<h2 class="label">Agent skills</h2>
				<a class="skills" href="https://github.com/50BytesOfJohn/skills" target="_blank" rel="noopener">
					<span class="skills-name">50BytesOfJohn/skills</span>
					<span class="skills-desc">
						Skills for coding agents &mdash; AAA unit tests, no-waffle writing, opencode CLI
						consultation, dependency updates and more.
					</span>
				</a>
			</section>

			<section>
				<h2 class="label">Projects</h2>
				<ul class="projects">
					{
						projects.map((project) => (
							<li>
								<a class="project-name" href={project.href} target="_blank" rel="noopener">
									{project.name}
								</a>
								<p class="project-desc">
									{project.description}
									{project.source && (
										<a class="project-source" href={project.source} target="_blank" rel="noopener">
											source ↗
										</a>
									)}
								</p>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2 class="label">Commits</h2>
				<ContributionGraph user="50BytesOfJohn" />
			</section>

			<footer class="contact">
				<p>
					Best way to reach me is a <a href="https://x.com/50BytesOfJohn" target="_blank" rel="noopener"
						>DM on X</a
					>.
				</p>
			</footer>
		</main>
	</body>
</html>

<style>
	.page {
		width: 100%;
		max-width: 36rem;
		margin-inline: auto;
		padding: clamp(3rem, 12vh, 7rem) 1.5rem 5rem;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	/*
	 * Wordmark: the only place the pixel face appears. 16px sits on Geist Pixel's own
	 * grid, so the glyphs stay crisp — 17/18px render soft. No synthetic bold either;
	 * the family only ships 400.
	 */
	.page :global(.wordmark) {
		margin: 0;
		font-family: var(--font-geist-pixel);
		font-size: 1rem;
		font-weight: 400;
		color: var(--ink);
	}

	/*
	 * Geist Pixel gives J a left side bearing twice the family norm, so "…OfJohn" opens
	 * a hole right after the tight "Of" pair. Pull the J back to the ~7/100em gap the
	 * rest of the wordmark sits at. Content-specific by nature — the wordmark is fixed.
	 */
	.page :global(.wordmark .shuffle-wrap[data-char='J']) {
		margin-inline-start: -0.04em;
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.label {
		margin: 0 0 1rem;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: text-decoration-color 150ms ease;
	}

	a:hover {
		text-decoration-color: var(--ink);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 1rem 1.125rem;
		border: 1px solid var(--rule);
		border-radius: 10px;
		text-decoration: none;
		transition:
			border-color 150ms ease,
			background-color 150ms ease;
	}

	.skills:hover {
		border-color: #d4d4d4;
		background-color: #fafafa;
	}

	.skills-name {
		font-weight: 500;
		color: var(--ink);
	}

	.skills-desc {
		text-wrap: pretty;
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.projects li {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 0 1.5rem;
	}

	.project-name {
		font-weight: 500;
		color: var(--ink);
	}

	.project-desc {
		margin: 0;
		text-wrap: pretty;
	}

	/* Sits after the sentence, so it has to read as metadata rather than as more prose. */
	.project-source {
		margin-inline-start: 0.5rem;
		font-size: 0.8125rem;
		color: var(--ink-faint);
		white-space: nowrap;
	}

	.contact {
		font-size: 0.875rem;
	}

	.contact p {
		margin: 0;
	}

	@media (max-width: 30rem) {
		.projects li {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
