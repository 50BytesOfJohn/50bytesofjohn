---
import { ArrowRight, Plus } from '@lucide/astro';
import { getCollection } from 'astro:content';
import ContributionGraph from '../components/ContributionGraph.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import SiteMasthead from '../components/SiteMasthead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PersonalPage from '../layouts/PersonalPage.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 4);

const elsewhere = [
	{ label: 'X', href: 'https://x.com/50BytesOfJohn' },
	{ label: 'GitHub', href: 'https://github.com/50BytesOfJohn' },
];

const projects = [
	{
		name: 'Mynth',
		href: 'https://mynth.io',
		description: 'Your Infra for AI media.',
		source: 'https://github.com/mynthio/oss',
		sourceLabel: 'oss source',
	},
	{
		name: 'Hanoki',
		href: 'https://hanoki.app',
		description: 'Local-first, open-source AI chat desktop app for macOS.',
		source: 'https://github.com/50BytesOfJohn/hanoki',
	},
	{
		name: 'Panqueue',
		href: 'https://panqueue.dev',
		description: 'Runtime-agnostic TypeScript queue library for Node, Bun and Deno.',
		source: 'https://github.com/50BytesOfJohn/panqueue',
	},
	{
		name: 'Prsna',
		href: 'https://prsna.app',
		description: 'AI roleplay chat and character generator.',
	},
	{
		name: 'WT Shop',
		href: '/projects/weronika-autorka/',
		description: 'Books shop with Stripe checkout, built on Astro and Cloudflare.',
		source: 'https://weronika-autorka.pl',
		sourceLabel: 'live site',
	},
];

// Client work. Real, but not what the page should lead with, so it sits behind a disclosure.
const moreProjects = [
	{
		name: 'LGD Sandomierz',
		href: 'https://portal.lgd-sandomierz.eu',
		description: 'Directus-backed portal for a local action group: content, listings and events.',
	},
	{
		name: 'Doradztwo CUD',
		href: 'https://www.doradztwocud.pl/',
		description: 'Logo, web design and build for a consulting practice.',
	},
];

const resources = [
	{
		name: 'Agent skills',
		href: '/skills/',
		description: 'Skills that grew out of my daily work with AI agents.',
		source: 'https://github.com/50BytesOfJohn/skills',
	},
];
---

<PersonalPage title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="intro">
		<SiteMasthead />
		<nav class="elsewhere" aria-label="Elsewhere">
			{
				elsewhere.map((item) => (
					<a href={item.href} rel="me">
						{item.label}
					</a>
				))
			}
		</nav>
	</div>

	<section>
		<h2 class="label">Projects</h2>
		<ProjectList items={projects} />
		<details class="more">
			<summary>
				<span class="more-label">More</span>
				<Plus size={14} stroke-width={1.5} aria-hidden="true" />
			</summary>
			<div class="more-body">
				<ProjectList items={moreProjects} />
			</div>
		</details>
	</section>

	<section>
		<h2 class="label">Resources</h2>
		<ProjectList items={resources} />
	</section>

	{
		posts.length > 0 && (
			<section>
				<h2 class="label">Writing</h2>
				<PostList posts={recentPosts} />
				{posts.length > recentPosts.length && (
					<a class="all-posts" href="/blog/">
						All posts
						<ArrowRight size={14} stroke-width={1.5} aria-hidden="true" />
					</a>
				)}
			</section>
		)
	}

	<section>
		<h2 class="label">Commits</h2>
		<ContributionGraph user="50BytesOfJohn" />
	</section>

	<footer class="contact">
		<p>
			Best way to reach me is a <a href="https://x.com/50BytesOfJohn" target="_blank" rel="noopener"
				>DM on X</a
			>.
		</p>
	</footer>
</PersonalPage>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.elsewhere {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.label {
		margin: 0 0 1rem;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: text-decoration-color 150ms ease;
	}

	a:hover {
		text-decoration-color: var(--ink);
	}

	.elsewhere a {
		color: var(--ink-muted);
		transition:
			color 150ms ease,
			text-decoration-color 150ms ease;
	}

	.elsewhere a:hover {
		color: var(--ink);
	}

	/* Opened rarely, so a native disclosure does the job with no JS and working keyboard support. */
	.more summary {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-block-start: 1.25rem;
		margin-inline-start: 8.5rem;
		width: fit-content;
		font-size: 0.875rem;
		color: var(--ink-muted);
		cursor: pointer;
		list-style: none;
		transition: color 150ms ease;
	}

	.more summary::-webkit-details-marker {
		display: none;
	}

	.more summary:hover {
		color: var(--ink);
	}

	.more-label {
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: text-decoration-color 150ms ease;
	}

	.more summary:hover .more-label {
		text-decoration-color: var(--ink);
	}

	.more-body {
		padding-block-start: 1.25rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* interpolate-size lets the auto height animate; unsupported browsers just snap open. */
		.more {
			interpolate-size: allow-keywords;
		}

		.more::details-content {
			height: 0;
			overflow: hidden;
			opacity: 0;
			transition:
				height 220ms var(--ease-out),
				opacity 220ms var(--ease-out),
				content-visibility 220ms allow-discrete;
		}

		.more[open]::details-content {
			height: auto;
			opacity: 1;
		}

		.more summary :global(svg) {
			transition: transform 220ms var(--ease-out);
		}

		.more[open] summary :global(svg) {
			transform: rotate(45deg);
		}
	}

	/* Sits under the entries, not under the year column, so the list keeps one edge. */
	.all-posts {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-block-start: 2rem;
		margin-inline-start: 8.5rem;
		font-size: 0.875rem;
		color: var(--ink-muted);
	}

	.all-posts:hover {
		color: var(--ink);
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.all-posts :global(svg) {
			transition: transform 150ms var(--ease-out);
		}

		.all-posts:hover :global(svg) {
			transform: translateX(3px);
		}
	}

	.contact {
		font-size: 0.875rem;
	}

	.contact p {
		margin: 0;
	}

	@media (max-width: 30rem) {
		.all-posts,
		.more summary {
			margin-inline-start: 0;
		}
	}
</style>
